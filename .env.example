# ==============================================================
# Email Marketing & Gemini AI Cold Outreach Configuration
# ==============================================================

# Google Gemini API Keys
# Get your free key at: https://aistudio.google.com/app/apikey
# You can provide multiple keys separated by commas for rotation
GEMINI_API_KEYS=key1,key2,key3
# (Optional fallback to single key)
# GEMINI_API_KEY=

# App Settings
HOST=127.0.0.1
PORT=8000
DEBUG=False
LOG_LEVEL=INFO
MAX_SCRAPE_WORKERS=4
MAX_EMAIL_RATE_DELAY=1.2

# SMTP Server Settings (Default: Gmail TLS on port 587)
# For Gmail, generate a 16-character App Password at:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=My Company
